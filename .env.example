# Copy to .env and fill in. Never commit .env.

# Optional. Without a key the app writes insights from templates (still fully working).
ANTHROPIC_API_KEY=

# Model used to phrase insights. Numbers are always computed in code, never by the model.
LLM_MODEL=claude-opus-5-5

# "auto" = use the LLM when a key is set, "off" = always use templates
LLM_MODE=auto

# Safety cap for the public demo so a shared link can't burn through credit
LLM_MAX_REPORTS_PER_HOUR=20

# SQLite file location
DB_PATH=app.db
